{
  "name": "studyspace-qa",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace backend",
    "test": "npm run test --workspace backend",
    "build": "npm run build --workspace backend && npm run build --workspace frontend",
    "e2e": "npm run db:seed && playwright test",
    "db:generate": "npm run prisma:generate --workspace backend",
    "db:seed": "npm run prisma:seed --workspace backend"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "lighthouse": "^13.5.0"
  }
}
